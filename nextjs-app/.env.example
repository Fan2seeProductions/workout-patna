# ─── Supabase Auth + DB ────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: service-role key for server actions/webhooks that need to bypass RLS
SUPABASE_SERVICE_ROLE_KEY=

# ─── Anthropic Claude (AI Daily Coach) ─────────────────────────────────────
# When unset, the coach falls back to a deterministic template.
ANTHROPIC_API_KEY=

# ─── Stripe (premium subscriptions) ────────────────────────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Price ID for the AI Daily Coach $9.99/mo subscription
STRIPE_AI_COACH_PRICE_ID=

# ─── Yelp Fusion (location data, future) ───────────────────────────────────
YELP_API_KEY=

# ─── Resend (operator email notifications for ALL intake forms) ───────────
# When RESEND_API_KEY is unset, forms still save to Supabase; only the email
# notification is skipped (graceful no-op).
RESEND_API_KEY=

# Sender — must be on a Resend-verified domain.
# Default: "Fan2See Productions <sales@fan2seeproductions.com>"
EMAIL_FROM=Fan2See Productions <sales@fan2seeproductions.com>

# Default recipient list (comma-separated). Used by every intake form unless a
# per-category override is set below.
LEAD_EMAIL=sales@fan2seeproductions.com,info@fan2seeproductions.com

# ─── Per-category routing (optional overrides) ─────────────────────────────
# Set any of these to route a specific form's notifications elsewhere
# without changing code. Falls back to LEAD_EMAIL if blank.
LEAD_EMAIL_ONBOARDING=
LEAD_EMAIL_COACH=
LEAD_EMAIL_TRAINERS=
LEAD_EMAIL_CONSULTATIONS=
LEAD_EMAIL_PARTNERS=
LEAD_EMAIL_BOOKINGS=
LEAD_EMAIL_SUPPORT=
LEAD_EMAIL_VENDORS=
LEAD_EMAIL_GENERAL=

# ─── Legacy email env vars (still honored as fallbacks for back-compat) ────
# Older code paths read these variable names. Leave blank in fresh deploys —
# LEAD_EMAIL / EMAIL_FROM above take precedence.
PARTNER_LEAD_EMAIL_TO=
PARTNER_LEAD_EMAIL_FROM=
INTAKE_NOTIFICATION_TO=

# ─── Playwright e2e tests ──────────────────────────────────────────────────
# Override the local server URL (defaults to http://localhost:3000)
PLAYWRIGHT_BASE_URL=
# Credentials for the seeded test user (auth + dashboard tests).
# Leave blank to skip those suites.
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
# Set to 1 to allow tests to actually create accounts via Supabase signUp.
# Off by default so CI runs don't flood auth.users.
E2E_ALLOW_SIGNUP=
